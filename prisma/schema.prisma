generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

enum RaffleStatus {
  ACTIVE
  FINISHED
  CANCELLED
}

model Client {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String
  cpf       String?  // CPF/CNPJ agora opcional
  stripe_id String?
  asaas_id  String?
  tickets   String
  units     Int      @default(1)
  amount    Float
  paid      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  raffleId  Int?
  raffle    Raffle?  @relation("RaffleClients", fields: [raffleId], references: [id])
  wonRaffle Raffle?  @relation("RaffleWinner")

  @@map("clients")
}

model Raffle {
  id        Int          @id @default(autoincrement())
  number    String?      @unique // Identificador do sorteio
  title     String?
  prize     String?      // Descrição detalhada do prêmio
  status    RaffleStatus @default(ACTIVE)
  winnerId  Int?         @unique
  winner    Client?      @relation("RaffleWinner", fields: [winnerId], references: [id])
  endDate   DateTime?
  drawDate  DateTime?
  videoUrl  String?
  metadata  Json?
  clients   Client[]     @relation("RaffleClients")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("raffle")
}

model Config {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String

  @@map("configs")
}

model Session {
  id           String   @id
  user_id      Int?
  ip_address   String?
  user_agent   String?
  payload      String
  last_activity Int

  @@map("sessions")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
